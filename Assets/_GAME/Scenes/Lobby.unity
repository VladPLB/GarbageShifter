--- !u!114 &1255035413
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1255035411}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 35d50a4c74694a21974266893f79ae2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _npc: 2
  _messages:
  - "\u041E! \u0412\u0441\u0435 \u0442\u0430\u043A\u0438 \u043E\u0447\u043D\u0443\u043B\u0441\u044F!
    \u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
    \u043D\u0430 \u0431\u043E\u0440\u0442\u0443 \u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0430!"
  - "\u042F \u043A\u0430\u043F\u0438\u0442\u0430\u043D \u044D\u0442\u043E\u0439 \u0440\u0443\u0445\u043B\u044F\u0434\u0438,
    \u043D\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E
    \u0411\u0440\u043E\u0442. "
  - "\u0414\u0443\u043C\u0430\u044E \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u0437\u0430\u0431\u0438\u0432\u0430\u0442\u044C
    \u0441\u0438\u043B\u044C\u043D\u043E \u0433\u043E\u043B\u043E\u0432\u0443, \u0440\u0430\u0441\u043A\u0430\u0436\u0443
    \u0432\u0441\u0435 \u0432 \u043A\u0440\u0430\u0442\u0446\u0435..."
  - "\u0415\u0441\u043B\u0438 \u043D\u0435 \u043E\u0448\u0438\u0431\u0430\u044E\u0441\u044C,
    \u0442\u0432\u043E\u044F \u043A\u0430\u043F\u0441\u0443\u043B\u0430 \u0434\u0440\u0435\u0439\u0444\u043E\u0432\u0430\u043B\u0430
    \u0431\u043E\u043B\u0435\u0435 300 \u043B\u0435\u0442... \u0418\u0437 \u0445\u043E\u0440\u043E\u0448\u0438\u0445
    \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439 - \u0430\u0440\u043C\u0438\u044F
    \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u043A\u043E\u0432 \u043F\u043E\u0431\u0435\u0436\u0434\u0435\u043D\u0430!
    \u0438\u0437 \u043F\u043B\u043E\u0445\u0438\u0445 - \u043E\u0442 \u0438\u043C\u043F\u0435\u0440\u0438\u0438
    \u0442\u043E\u0436\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C..."
  - "\u041C\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u043C\u0441\u044F \u043D\u0430
    \u043E\u0434\u043D\u043E\u043C \u0438\u0437 \"\u043A\u043E\u0432\u0447\u0435\u0433\u043E\u0432\",
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0443\u0446\u0435\u043B\u0435\u043B\u0438
    \u0438 \u0434\u0440\u0435\u0439\u0444\u0443\u044E\u0442 \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
    \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0438\u0445 \u043A\u043E\u043B\u043E\u043D\u0438\u0439."
  - "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0433\u0438\u043F\u0435\u0440\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430
    \u043D\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u043B\u0435\u0442\u0438\u043C \u043A\u0430\u043A \u0435\u0441\u0442\u044C \u0441
    \u043D\u0430\u0434\u0435\u0436\u0434\u043E\u0439 \u0438 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435\u043C."
  - "\u0422\u0430\u043A \u0436\u0435 \u043C\u044B \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u043E\u0432\u0430\u043B\u0438
    \u0442\u0432\u043E\u044E \u043A\u0430\u043F\u0441\u0443\u043B\u0443 \u043D\u0430
    \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438, \u043D\u043E \u043D\u0435 \u0433\u0440\u0443\u0441\u0442\u0438
    - \u044F \u0432\u044B\u0434\u0435\u043B\u044E \u0442\u0435\u0431\u0435 \u0441\u0432\u043E\u0435\u0433\u043E
    \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0424\u0430\u043B\u044C\u043A\u043E\u043D\u0430...
    \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u044F \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E
    \u043D\u0435 \u043F\u043E\u043A\u0438\u0434\u0430\u044E \u0441\u0432\u043E\u0439
    \u043F\u043E\u0441\u0442..."
  - "\u0417\u0430\u043D\u044F\u0442\u0438\u0439 \u0443 \u043D\u0430\u0441 \u043D\u0435
    \u043C\u043D\u043E\u0433\u043E: \u0421\u043E\u0431\u0438\u0440\u0430\u0435\u043C
    \u043B\u043E\u043C \u0441 \u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432 \u0431\u044B\u0432\u0448\u0435\u0439
    \u0438\u043C\u043F\u0435\u0440\u0438\u0438, \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0435\u043C\u0441\u044F
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u043A\u043E\u0432\u0447\u0435\u0433\u0430\u043C\u0438,
    \u0447\u0438\u043D\u0438\u043C \u044D\u0442\u0443 \u043F\u043E\u0441\u0443\u0434\u0438\u043D\u0443,
    \u043D\u0430\u0434\u0435\u0435\u043C\u0441\u044F \u0434\u043E\u043B\u0435\u0442\u0435\u0442\u044C..."
  - "\u0422\u0430\u043A \u0447\u0442\u043E \u0434\u0443\u043C\u0430\u044E \u043B\u0443\u0447\u0448\u0435\u0439
    \u0440\u0435\u0430\u0431\u0438\u043B\u0438\u0442\u0430\u0446\u0438\u0435\u0439
    \u0431\u0443\u0434\u0435\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C!
    \u042F \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u043B \u0442\u0432\u043E\u0439
    \u043F\u043B\u0430\u043D\u0448\u0435\u0442 \u043A \u043D\u0430\u0448\u0438\u043C
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u043C... \u0433\u043B\u044F\u043D\u044C
    \u043A\u0430!"
  _animations: 0800000009000000000000000000000000000000000000000b0000000000000000000000
