--- !u!114 &1241548094
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1241548092}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 35d50a4c74694a21974266893f79ae2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _npc: 2
  _messages:
  - "\u0422\u0443\u0442 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0443\u0432\u0438\u0434\u0435\u0442\u044C
    \u043D\u0430\u0448 \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u0432\u0441\u044F\u043A\u0438\u0439
    \u0445\u043B\u0430\u043C \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u043F\u043E\u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438..."
  - "\u0421\u0435\u0439\u0447\u0430\u0441 \u043C\u044B \u043A\u0430\u043A \u0440\u0430\u0437
    \u043F\u0440\u043E\u043B\u0435\u0442\u0430\u0435\u043C \u0441\u0442\u0430\u0440\u0443\u044E
    \u0441\u0442\u0430\u043D\u0446\u0438\u044E \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F
    \u0432\u0440\u0435\u043C\u0435\u043D \"\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
    \u0432\u043E\u0439\u043D\u044B\"."
  - "\u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u043F\u043E\u043B\u0435\u0442\u0435\u0442\u044C
    \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u044E, \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    \u0432\u0441\u0435 \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F
    \u0434\u043B\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0438 \u043A\u043E\u0440\u0430\u0431\u043B\u044F
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435
    \u0448\u0442\u0443\u043A\u0438. \u041D\u0443 \u0438 \u0443\u0441\u043F\u0435\u0442\u044C
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043F\u043E\u043A\u0430
    \u043D\u0435 \u043E\u0442\u043B\u0435\u0442\u0435\u043B\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0434\u0430\u043B\u0435\u043A\u043E..."
  - "\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C
    \u043F\u0443\u0448\u043A\u0443, \u043F\u0438\u0440\u0430\u0442\u044B \u044D\u0442\u043E
    \u0434\u0435\u043B\u043E \u043E\u0431\u044B\u0434\u0435\u043D\u043D\u043E\u0435...
    \u0423\u0434\u0430\u0447\u0438!"
  _animations: 00000000000000000000000000000000
