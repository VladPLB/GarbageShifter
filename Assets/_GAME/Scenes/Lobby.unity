  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 35d50a4c74694a21974266893f79ae2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _npc: 1
  _messages:
  - "\u041E, \u0442\u044B \u043E\u0447\u043D\u0443\u043B\u0441\u044F! \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E!
    \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0433\u043B\u044F\u043D\u0443\u0442\u044C
    \u0432\u0430\u0448\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435"
  - "\u0422\u0430\u043A\u0441... \u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B
    \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u043E\u0433\u043E...
    \u041F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439 \u043C\u043E\u0437\u0433\u0430
    \u043D\u0435\u0442\u0443 - \u0445\u043E\u0440\u043E\u0448\u043E..."
  - "\u041C\u043E\u0433\u0443 \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u0438\u0442\u044C
    \u0441 \u0435\u0449\u0435 \u043E\u0434\u043D\u0438\u043C \u0414\u043D\u0435\u043C
    \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F! \u041C\u043E\u0436\u0435\u0448\u044C
    \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044C"
  _animations: 050000000c00000005000000
